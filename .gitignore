# Python tooling
.venv/
__pycache__/
.pytest_cache/
*.pyc

# Node modules — installed via `npm install --omit=dev` at repo root
node_modules/

# macOS
.DS_Store

# Core dumps — a crashing child process (e.g. an embedded PTY) drops one in its
# CWD; the kernel core_pattern here is bare "core". Never commit these.
# (A future legitimately-named `core` file/dir would need `git add -f`.)
core
core.[0-9]*

# npm pack output (build artifact; never commit)
*.tgz

# Bun compile artifacts (in-repo `bun build --compile` scratch)
*.bun-build

# Personal, per-machine files — never shipped: Claude Code's local permission
# allowlist (holds absolute local paths) and a personal git-diff pager script.
.claude/settings.local.json
x.sh
